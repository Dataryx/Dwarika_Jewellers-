# Copy to `.env` for local + VPS. Only this template is committed.

# --- MongoDB ---
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/Dwarika?retryWrites=true&w=majority&appName=dwarika
MONGODB_DB_NAME=Dwarika

# --- Required in production ---
CUSTOMER_AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_AUTH_SECRET=change-me-to-another-long-random-string
ALLOWED_ORIGINS=https://your-store.com,https://admin.your-store.com

# VPS
ADMIN_HOST=admin.your-store.com
TRUST_PROXY=1
# ADMIN_ALLOWED_IPS=203.0.113.10
# ADMIN_BOOTSTRAP_PASSWORD=

# Frontend build URLs (used by Vite for store + admin)
VITE_STOREFRONT_URL=https://your-store.com
VITE_API_URL=https://your-store.com
VITE_ADMIN_URL=https://admin.your-store.com

# Optional
# RAPIDAPI_KEY=
# MAX_API_BODY_BYTES=1200000
# REQUEST_TIMEOUT_MS=60000
# ADMIN_TOKEN_TTL_MS=28800000
# ADMIN_MAX_FAILED_LOGINS=8
# ADMIN_LOCKOUT_MS=1800000

# Optional SMTP fallback (prefer Admin → SMTP in dashboard)
# SMTP_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=your@gmail.com
# SMTP_FROM_NAME=Dwarika
