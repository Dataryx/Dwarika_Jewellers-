# Homepage bullion ticker (priority):
# 1. FENEGOSIDA official site (fenegosida.org) — free, no key, matches Google/board rates
# 2. Optional RapidAPI: https://rapidapi.com/sourcenp/api/gold-and-silver-price-in-nepal
# RAPIDAPI_KEY=
# Product pricing uses Admin → Settings → Pricing (set gold rate ≈ fine gold per gram from ticker).

# Optional SMTP fallback (prefer Admin → SMTP in dashboard; stored in MongoDB)
# SMTP_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=your@gmail.com
# SMTP_FROM_NAME=Dwarika

# --- Separate hosting (storefront + admin on different domains) ---
# Local dev defaults are set automatically. For production, set these before building.

# Storefront build (.env.production) — optional; API uses same origin when VITE_API_URL is empty
# VITE_API_URL=

# Admin build — copy .env.admin.example to .env.admin, then run: npm run build:admin
# VITE_STOREFRONT_URL=https://your-store.com
# VITE_API_URL=https://your-store.com
# VITE_ADMIN_URL=https://admin.your-store.com
