# Admin panel — build-time only (npm run build:admin / Vercel admin project)
# Copy to .env.admin locally, or import .env.admin1 on Vercel.

# Public storefront URL ("View Store" links in admin)
VITE_STOREFRONT_URL=https://dwarika-jewellers.vercel.app

# Store project URL — all /api/* requests go here (must match deployed store)
VITE_API_URL=https://dwarika-jewellers.vercel.app

# Optional — admin site URL for password-reset emails
# VITE_ADMIN_URL=https://your-admin.vercel.app
