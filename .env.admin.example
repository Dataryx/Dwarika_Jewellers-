# Admin panel — used when building separately (npm run build:admin)
# Copy to .env.admin and set your live store domain before deploying admin.

# Public storefront URL (used for "View Store" links in admin)
VITE_STOREFRONT_URL=https://your-store.com

# Backend API URL (same as storefront when API is deployed with the store)
VITE_API_URL=https://your-store.com
