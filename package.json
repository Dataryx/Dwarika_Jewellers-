{
  "name": "dwarika",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "seed:mongo": "node --env-file=.env ./scripts/seed-mongo.mjs",
    "seed:smtp": "node --env-file=.env ./scripts/seed-smtp.mjs",
    "mongo:init": "node --env-file=.env ./scripts/init-mongo-collections.mjs",
    "mongo:setup": "npm run mongo:init && npm run seed:mongo",
    "dev": "node scripts/dev-all.mjs",
    "dev:store": "vite",
    "dev:admin": "vite --config vite.admin.config.ts",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "build:admin": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build --config vite.admin.config.ts --mode admin",
    "build:all": "npm run build && npm run build:admin",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:admin": "vite preview --config vite.admin.config.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "framer-motion": "^12.35.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.577.0",
    "mongodb": "^6.12.0",
    "nodemailer": "^8.0.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
