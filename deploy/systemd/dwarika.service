[Unit]
Description=Dwarika Jewellers web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dwarika
Group=dwarika
WorkingDirectory=/var/www/dwarika
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
EnvironmentFile=/var/www/dwarika/.env
ExecStart=/usr/bin/node /var/www/dwarika/server.mjs
Restart=always
RestartSec=5
TimeoutStopSec=20

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/dwarika
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

# Resource limits (adjust for VPS size)
LimitNOFILE=65535
MemoryMax=768M

[Install]
WantedBy=multi-user.target
