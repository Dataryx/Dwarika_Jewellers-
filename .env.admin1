# Vercel import — Admin project ONLY (second Vercel project)
# Settings → Environment Variables → Import .env
# Scope: Production (and Preview if you use preview deploys)
# These are baked in at BUILD time — redeploy admin after any change.
#
# Do not commit this file.

# Tells Vercel to build the admin panel (not the storefront). Required on admin project only.
DWARIKA_APP=admin

VITE_STOREFRONT_URL=https://dwarika-jewellers.vercel.app
VITE_API_URL=https://dwarika-jewellers.vercel.app
VITE_ADMIN_URL=https://dwarika-admin.vercel.app
